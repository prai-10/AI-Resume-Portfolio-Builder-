# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Leave empty for local development — Vite proxies /api to localhost:5000.
# In production (when frontend and backend are on separate hosts), set this
# to your deployed backend URL, e.g:
#   VITE_API_URL=https://your-backend.com
# The frontend will then call https://your-backend.com/api/...
VITE_API_URL=

# Note: all VITE_* variables are bundled into the client build at build time.
# Never put AI_API_KEY or any secret here — they would be exposed in the browser bundle.
