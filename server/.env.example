# ─── AI Provider ────────────────────────────────────────────────────────────
# Leave AI_API_KEY empty to use Demo Mode (generates resumes from stored profile data
# without any external AI call). Set it to use Live AI.
AI_API_KEY=

# Model name — any OpenAI-compatible model
AI_MODEL=gpt-3.5-turbo

# API base URL — override for non-OpenAI compatible providers:
#   Groq:    https://api.groq.com/openai/v1
#   Azure:   https://<your-resource>.openai.azure.com/openai/deployments/<deployment>
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# The URL(s) your frontend is served from.
# Comma-separate for multiple origins: http://localhost:5173,https://your-app.com
CLIENT_URL=http://localhost:5173
